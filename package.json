{
  "name": "oxlint-plugin-jev",
  "version": "0.1.3",
  "description": "Oxlint JS plugin that lints code with plain-English rules answered by TypeSafe Jev.",
  "keywords": [
    "jev",
    "lint",
    "oxlint",
    "oxlint-plugin",
    "typesafe"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp run build && vp test",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "example": "vp run build && ./node_modules/oxlint/bin/oxlint -c example/.oxlintrc.json example/",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "synckit": "^0.11.13"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@types/node": "^26.1.1",
    "oxlint": "1.83.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.4"
  },
  "peerDependencies": {
    "oxlint": ">=1.83.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">= 20"
  }
}
